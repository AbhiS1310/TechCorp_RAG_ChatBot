# Founder BI Agent Configuration
# Copy this to .env and fill in your values

# FastAPI Server
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false


# Groq / LLM
# Get your key from: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json